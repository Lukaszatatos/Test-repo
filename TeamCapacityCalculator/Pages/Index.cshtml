@page
@model IndexModel

@{
    ViewData["Title"] = "Team Capacity Calculator";
}
<style>
    body {
        background-image: url('/images/background.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .calculator-container {
        background-color: rgba(255,255,255,0.9);
        padding: 20px;
        border-radius: 10px;
    }

    .kpi-card {
        padding: 15px;
        border-radius: 8px;
        width: 220px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }
</style>

<h1>Team Capacity Calculator</h1>

<div class="card p-4 mt-3">

<form method="post">
    <div>
        <label>Liczba pracowników:</label>
        <input type="number" asp-for="EmployeeCount" />
    </div>

    <div>
        <label>Dni robocze:</label>
        <input type="number" asp-for="WorkingDays" />
    </div>

    <div>
        <label>Dostępność (%):</label>
        <input type="number" asp-for="Availability" min="0" max="100" />
    </div>

    <div>
        <label>Koszt 1 FTE (PLN):</label>
        <input type="number" asp-for="CostPerFte" />
    </div>

    <button type="submit">Oblicz</button>
</form>
</div>
<hr />
<h2>Wynik</h2>

@if (Model.CapacityHours > 0)
{
    <div style="display:flex; gap:20px; flex-wrap:wrap; align-items:flex-start;">
        <div class="kpi-card" style="background:#dbeafe;">
            <h3>CapacityHours</h3>
            @if (Model.CapacityHours < 500)
            {
                <p style="color:red;">Capacity: @Model.CapacityHours godzin</p>
            }
            else
            {
                <p style="color:green;">Capacity: @Model.CapacityHours godzin</p>
            }
        </div>

        <div class="kpi-card" style="background:#dbeafe;">
            <h3>Dostępne FTE</h3>
            <p>@Model.AvailableFTE</p>
        </div>

        <div class="kpi-card" style="background:#ede9fe;">
            <h3>Monthly Capacity</h3>
            <p>@Model.MonthlyCapacity godzin</p>
        </div>

        <div class="kpi-card" style="background:#dcfce7;">
            <h3>Annual Capacity</h3>
            <p>@Model.AnnualCapacity godzin</p>
        </div>

        <div class="kpi-card" style="background:#fed7aa;">
            <h3>Estimated Cost</h3>
            <p>Szacowany koszt: @Model.TotalCost PLN</p>
        </div>

        <div class="kpi-card" style="background:@(Model.Status.Contains("🔴") ? "#fecaca" : Model.Status.Contains("🟡") ? "#fef3c7" : "#dcfce7");">
            <h3>Status</h3>
            <p><strong>Status:</strong> @Model.Status</p>
        </div>
    </div>
}
